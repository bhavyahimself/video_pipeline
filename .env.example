# Video Pipeline - Environment Variables
# Copy this to .env and fill in your API keys

# OpenAI (for GPT-4 script generation + embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs (for AI voiceover)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_default_voice_id_here

# Pexels (for stock footage)
PEXELS_API_KEY=your_pexels_api_key_here

# Reddit (for "Rank the Room" + content sourcing)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=video_pipeline/1.0

# Twelve Labs (for visual video search - optional)
TWELVE_LABS_API_KEY=your_twelve_labs_key_here

# YouTube Data API (for auto-upload - optional)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Anthropic (alternative to OpenAI - optional)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Pipeline Settings
DEFAULT_VIDEO_QUALITY=1080
DEFAULT_CLIP_MAX_SECONDS=10
OUTPUT_DIR=output
TRANSCRIPTS_DIR=transcripts
CLIPS_DIR=clips

