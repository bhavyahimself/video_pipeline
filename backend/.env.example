# ClipEngine Configuration
# Copy this to .env and fill in your values

# ── App ──────────────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=your-secret-key-change-me
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://clipengine:clipengine@localhost:5432/clipengine
DATABASE_SYNC_URL=postgresql://clipengine:clipengine@localhost:5432/clipengine

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=jwt-secret-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Storage (S3 / MinIO) ────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=clipengine
S3_PUBLIC_URL=http://localhost:9000/clipengine

# ── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_STUDIO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── AI APIs ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# ── Content Sources ──────────────────────────────────────────────
PEXELS_API_KEY=
TWELVE_LABS_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
